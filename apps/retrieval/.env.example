# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://plantpulse:devonly@127.0.0.1:5432/plantpulse

# Optional: enables the fluent LLM explanation (compose.py) and LLM product checks.
# Without it the API still works, using the template composer.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Optional: enables live product/price search (products.py) via Serper.dev.
SERPER_API_KEY=
SHOP_COUNTRY=in

# Confidence gate thresholds (pipeline.py)
UNSURE_THRESHOLD=0.6
OOD_FLOOR=0.35
