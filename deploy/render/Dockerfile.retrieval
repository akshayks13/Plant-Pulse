# Treatment / retrieval service for a 512 MB Render free instance.
# Build context: repository root.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    EMBEDDING_BACKEND=fastembed \
    FASTEMBED_CACHE_PATH=/opt/fastembed

WORKDIR /srv
COPY deploy/render/requirements-retrieval.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

# Bake the embedding model into the image so start-up does not download it
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5')"

COPY apps/retrieval /srv/apps/retrieval
WORKDIR /srv/apps/retrieval
EXPOSE 10000
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT:-10000}"]
